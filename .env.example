# RSyslog Web Configuration
# Kopiere diese Datei nach .env oder passe die Werte hier an.

# Web Dashboard Einstellungen
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Syslog Server Einstellungen
# HINWEIS: Port 514 benötigt unter Linux/macOS Root-Rechte (sudo). 
# Port 5514 kann ohne Root-Rechte ausgeführt werden.
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
SYSLOG_BIND_HOST=0.0.0.0

# Datenbank
DATABASE_PATH=syslog.db

# Alarmierung: Telegram (Optional)
# Erstelle einen Bot via @BotFather auf Telegram, um den Token zu erhalten.
# Deine Chat-ID erhältst du z.B. über den Bot @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alarmierung: Ntfy (Optional)
# Kostenloser, offener Push-Dienst ohne Account: https://ntfy.sh
# Wähle ein beliebiges individuelles Thema (z.B. mein-syslog-alarm-9876)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Mindest-Level für Alarme (CRITICAL, ERROR, WARN, INFO)
ALERT_MIN_LEVEL=ERROR

# Spamschutz: Mindest-Sekunden zwischen zwei Alarmen für gleiche/ähnliche Fehler
ALERT_THROTTLE_SECONDS=10

# GitHub Projekt-Link
GITHUB_URL=https://github.com/Schello805/rsyslog
